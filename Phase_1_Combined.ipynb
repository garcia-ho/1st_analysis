    "legacy, legacy_meta = prepare_dataset(\n",
    "    'datasets/AI_Lit_Que_1111.csv',\n",
    "    'datasets/AI_Lit_Que_1204.csv',\n",
    "    course_labels=['1111_25', '1204_25'],\n",
    ")\n",
    "current, current_meta = prepare_dataset(\n",
    "    'datasets/AI_Lit_Que_1111_26.csv',\n",
    "    'datasets/AI_Lit_Que_1201_26.csv',\n",
    "    course_labels=['1111_26', '1201_26'],\n",
    ")\n",
    "\n",
    "legacy['source_dataset'] = legacy['course'].astype(str)\n",
    "current['source_dataset'] = current['course'].astype(str)\n",
    "df = pd.concat([legacy, current], ignore_index=True, sort=False)\n",
    "df['id'] = validate_unique_ids(df, 'id', context='Combined Phase I')\n",
    "df, ses_reference_means, ses_reference_sds = score_ses_index(df)\n",
    "df['course'] = 'Combined'\n",
    "\n",
    "meta = {\n",
    "    'ai_scored_cols': list(AI_EFA_ITEMS),\n",
    "    'ses_scored_cols': list(SES_INDEX_ITEMS),\n",
    "    'ses_reference_means': ses_reference_means,\n",
    "    'ses_reference_sds': ses_reference_sds,\n",
    "}\n",
    "\n",
    "source_audit = (\n",
    "    df.groupby('source_dataset', sort=False)\n",
    "      .agg(n=('id', 'size'), unique_ids=('id', 'nunique'))\n",
    "      .reset_index()\n",
    ")\n",
    "display(source_audit)\n",
    "print(f'Combined sample: {len(df)} rows; {df.id.nunique()} unique IDs')"
   ]
  },
