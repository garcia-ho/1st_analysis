    "pooled_summary = pd.DataFrame([\n",
    "    {\n",
    "        'construct': label,\n",
    "        'n': df[column].notna().sum(),\n",
    "        'mean': df[column].mean(),\n",
    "        'sd': df[column].std(ddof=1),\n",
    "        'median': df[column].median(),\n",
    "        'iqr': df[column].quantile(.75) - df[column].quantile(.25),\n",
    "    }\n",
    "    for label, column in {\n",
    "        'SES index': 'ses_index',\n",
    "        'AI literacy score': 'ai_lit_score',\n",
    "    }.items()\n",
    "])\n",
    "pooled_reliability = pd.DataFrame([\n",
    "    {'construct': 'SES index ingredients', 'alpha': cronbach_alpha(df[list(SES_INDEX_ITEMS)]),\n",
    "     'n_complete': len(df[list(SES_INDEX_ITEMS)].dropna())},\n",
    "    {'construct': 'AI literacy items', 'alpha': cronbach_alpha(df[list(AI_EFA_ITEMS)]),\n",
    "     'n_complete': len(df[list(AI_EFA_ITEMS)].dropna())},\n",
    "])\n",
    "standardization_check = pd.DataFrame([{\n",
    "    'score': 'SES index',\n",
