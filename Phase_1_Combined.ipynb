    "analysis_vars = [\n",
    "    'ses_index', 'practical_ai_use_score', 'language_load_score',\n",
    "    'epistemic_stance_score', 'ai_factor1_score', 'ai_factor2_score',\n",
    "]\n",
    "pc_obj = partial_corr_matrix(df_analysis, analysis_vars)\n",
    "network_labels = {\n",
    "    'ses_index': 'Overall SES',\n",
    "    'practical_ai_use_score': 'Practical AI use',\n",
    "    'language_load_score': 'Language load',\n",
    "    'epistemic_stance_score': 'Epistemic stance',\n",
    "    'ai_factor1_score': 'AI understanding',\n",
    "    'ai_factor2_score': 'AI confidence',\n",
    "}\n",
    "pc_obj['estimate'] = pc_obj['estimate'].rename(index=network_labels, columns=network_labels)\n",
    "pc_obj['p_value'] = pc_obj['p_value'].rename(index=network_labels, columns=network_labels)\n",
    "pc_obj['n'] = pc_obj['n'].rename(index=network_labels, columns=network_labels)\n",
    "plot_partial_corr_heatmap(pc_obj, adjust_method='fdr_bh', alpha=.05, sig_only=True, figsize=(12, 10))\n",
    "edges = build_network_edges(pc_obj, adjust_method='fdr_bh', alpha=.05)\n",
    "edges_holm = build_network_edges(pc_obj, adjust_method='holm', alpha=.05)\n",
    "network_correction_summary = pd.DataFrame({\n",
    "    'method': ['Benjamini-Hochberg FDR', 'Holm family-wise error'],\n",
    "    'retained_edges': [len(edges), len(edges_holm)],\n",
    "})\n",
    "display(network_correction_summary)\n",
    "display(edges)\n",
    "display(edges_holm)\n",
    "G = build_network_graph(edges, node_groups=node_groups)\n",
    "plot_network_graph(G, layout='spring', figsize=(12, 10))"
   ]
